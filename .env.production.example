# ==============================================================================
# NOROFARM PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================

# --- System & Security ---
ENVIRONMENT=production
PROJECT_NAME="NoroFarm API"
VERSION=1.0.0
API_V1_STR=/api/v1
SECRET_KEY=generate-a-secure-random-64-character-secret-key-here
ACCESS_TOKEN_EXPIRE_MINUTES=43200
REFRESH_TOKEN_EXPIRE_DAYS=7
EMAIL_TOKEN_EXPIRE_HOURS=24

# --- Domain & CORS ---
# Danh sách origins được phép kết nối API (phân cách bằng JSON array)
BACKEND_CORS_ORIGINS=["https://norofarm.com","https://www.norofarm.com","https://admin.norofarm.com"]
FRONTEND_URL=https://norofarm.com

# --- Database (Supabase PostgreSQL / AWS RDS) ---
# Dùng chuỗi kết nối Session Pooler (port 5432) hỗ trợ Transaction & IPv4
SUPABASE_DB_URL=postgresql+asyncpg://postgres.<project_ref>:<password>@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres
SUPABASE_URL=https://<project_ref>.supabase.co
SUPABASE_KEY=<supabase_service_role_key>

# --- Cache & Scheduler (Redis) ---
REDIS_URL=redis://redis:6379/0

# --- SMTP Mailer (Google Workspace / AWS SES) ---
SMTP_HOST=email-smtp.ap-southeast-1.amazonaws.com
SMTP_PORT=587
SMTP_USER=YOUR_SES_SMTP_USERNAME
SMTP_PASSWORD=YOUR_SES_SMTP_PASSWORD
SMTP_TLS=true
EMAIL_FROM_NAME="NoroFarm Vietnam"
EMAIL_FROM_ADDRESS=noreply@norofarm.com

# --- External APIs ---
OPENWEATHER_API_KEY=YOUR_OPENWEATHERMAP_API_KEY

# --- Web Push (VAPID) ---
# Tạo bằng lệnh: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=YOUR_VAPID_PUBLIC_KEY
VAPID_PRIVATE_KEY=YOUR_VAPID_PRIVATE_KEY
VAPID_CLAIM_EMAIL=mailto:admin@norofarm.com

# --- Stripe Payments ---
STRIPE_API_KEY=sk_live_YOUR_STRIPE_LIVE_KEY
STRIPE_WEBHOOK_SECRET=whsec_YOUR_STRIPE_WEBHOOK_SIGNING_SECRET

# --- Observability & Telemetry ---
OTLP_ENDPOINT=http://norofarm_otel_collector:4317
